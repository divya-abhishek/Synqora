<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\synqora.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <Company>Synqora</Company>
    <Product>Synqora</Product>
    <Description>Synqora encrypted phone audio, camera and remote controls</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\core\Synqora.Core.csproj" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\native\camera\build\Synqora.Camera.dll" Link="Synqora.Camera.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\native\camera\build\Synqora.Camera.dll')" />
    <Content Include="..\..\native\camera\build\CameraDeviceProbe.exe" Link="Synqora.CameraCheck.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\native\camera\build\CameraDeviceProbe.exe')" />
  </ItemGroup>
  <!-- This C#-only unpackaged application still needs the merged WinUI resource
       index. Explicitly generate and publish it; a successful .NET publish alone
       previously omitted it even though the build output ran correctly. -->
  <Target Name="PublishSynqoraResourceIndex" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="_GenerateProjectPriFile">
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="The Synqora WinUI resource index was not generated: $(ProjectPriFullPath)" />
    <ItemGroup>
      <ResolvedFileToPublish Remove="$(ProjectPriFullPath)" />
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)" RelativePath="$(ProjectPriFileName)" CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>
</Project>
