; Synqora development capture endpoint. Requires Microsoft-trusted signing for distribution.
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/20/2026,0.1.0.0
CatalogFile=SynqoraMicrophone.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Synqora,NTamd64.10.0...19041
[Synqora.NTamd64.10.0...19041]
%DeviceName%=Microphone,Root\SynqoraMicrophone

[SourceDisksNames]
1=%DiskName%
[SourceDisksFiles]
SynqoraMicrophone.sys=1
[DestinationDirs]
DriverFiles=13
[DriverFiles]
SynqoraMicrophone.sys

[Microphone.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverFiles
AddReg=AudioRegistration
[AudioRegistration]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,"SynqoraMicrophone.sys"
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,"wdmaud.drv"
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
HKR,Drivers\mixer\wdmaud.drv,Driver,,"wdmaud.drv"
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceName%
HKR,MediaCategories\{9ce8e587-6835-44a9-8e57-c39ee01ea1a7},Name,,%DeviceName%

[Microphone.NT.Interfaces]
AddInterface=%Audio%,"WaveMicIn",WaveInterface
AddInterface=%Capture%,"WaveMicIn",WaveInterface
AddInterface=%Realtime%,"WaveMicIn",WaveInterface
AddInterface=%Audio%,"TopologyMicIn",TopologyInterface
AddInterface=%Topology%,"TopologyMicIn",TopologyInterface
[WaveInterface]
AddReg=WaveProperties
[WaveProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%DeviceName%
[TopologyInterface]
AddReg=TopologyProperties
[TopologyProperties]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%DeviceName%
HKR,EP\0,%Association%,,"{00000000-0000-0000-0000-000000000000}"
HKR,EP\0,%EventDriven%,0x00010001,1

[Microphone.NT.Services]
AddService=SynqoraMicrophone,0x00000002,MicrophoneService
[MicrophoneService]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\SynqoraMicrophone.sys
[Microphone.NT.Wdf]
KmdfService=SynqoraMicrophone,Framework
[Framework]
KmdfLibraryVersion=1.15
[Microphone.NT.HW]
AddReg=HardwareProperties
[HardwareProperties]
HKR,,DeviceType,0x00010001,0x1D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[Strings]
Provider="Synqora"
DeviceName="Synqora Microphone"
DiskName="Synqora Microphone Driver"
Proxy="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
Audio="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
Capture="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
Realtime="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
Topology="{DDA54A40-1E4C-11D1-A050-405705C10000}"
Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
